generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String     @id @default(uuid())
  name             String
  legalName        String?
  rfc              String?    @unique
  phone            String?
  email            String?
  address          String?
  logo             String?
  website          String?    // 👈 Nuevo: Sitio web/Redes sociales
  ticketHeader     String?    // 👈 Nuevo: Texto superior en tickets (ej: "¡Gracias por visitarnos!")
  ticketFooter     String?    // 👈 Nuevo: Texto inferior (ej: "No se aceptan devoluciones")
  autoPrintReceipt Boolean    @default(true) // 👈 Nuevo: Imprimir ticket automáticamente al vender
  paperWidth       String     @default("80mm") // 👈 Nuevo: Ancho predeterminado (80mm o 58mm)
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  products         Product[]
  stores           Store[]
  suppliers        Supplier[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

model Store {
  id                String      @id @default(uuid())
  companyId         String
  code              String      @unique
  name              String
  address           String?
  phone             String?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  inventory         Inventory[]
  purchases         Purchase[]
  registers         Register[]
  company           Company     @relation(fields: [companyId], references: [id])
  transfersSent     Transfer[]  @relation("SourceStore")
  transfersReceived Transfer[]  @relation("DestinationStore")
  users             UserStore[]
}

model Register {
  id        String    @id @default(uuid())
  storeId   String
  code      String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  printers  Printer[]
  store     Store     @relation(fields: [storeId], references: [id])
  sessions  Session[]

  @@unique([storeId, code])
}

model Session {
  id             String    @id @default(uuid())
  registerId     String
  userId         String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  
  initialCash    Decimal   @db.Decimal(10, 2) // Fondo inicial
  expectedCash   Decimal?  @db.Decimal(10, 2) // 👈 NUEVO: initialCash + ventas en efectivo
  finalCash      Decimal?  @db.Decimal(10, 2) // Lo que el cajero contó físicamente
  difference     Decimal?  @db.Decimal(10, 2) // 👈 NUEVO: finalCash - expectedCash (Faltante/Sobrante)
  notes          String?   // 👈 NUEVO: Observaciones del cajero al cerrar
  
  isOpen         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  
  sales          Sale[]
  register       Register  @relation(fields: [registerId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id          String           @id @default(uuid())
  companyId   String
  categoryId  String
  brandId     String?
  name        String
  description String?
  image       String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  brand       Brand?           @relation(fields: [brandId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  company     Company          @relation(fields: [companyId], references: [id])
  variants    ProductVariant[]
}

model Color {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  hexCode   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Size {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  order     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id            String         @id @default(uuid())
  productId     String
  colorId       String
  sizeId        String
  sku           String         @unique
  barcode       String         @unique
  supplierSku String?
  supplierBarcode String?
  cost          Decimal        @db.Decimal(10, 2)
  price         Decimal        @db.Decimal(10, 2)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventory     Inventory[]
  color         Color          @relation(fields: [colorId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  size          Size           @relation(fields: [sizeId], references: [id])
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  transferItems TransferItem[]

  @@unique([productId, colorId, sizeId])
}

model Supplier {
  id          String     @id @default(uuid())
  companyId   String
  name        String
  contactName String?
  phone       String?
  email       String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
  company     Company    @relation(fields: [companyId], references: [id])
}

model Purchase {
  id         String         @id @default(uuid())
  supplierId String
  storeId    String
  total      Decimal        @db.Decimal(10, 2)
  invoice    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  store      Store          @relation(fields: [storeId], references: [id])
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]
}

model PurchaseItem {
  id               String         @id @default(uuid())
  purchaseId       String
  productVariantId String
  quantity         Int
  cost             Decimal        @db.Decimal(10, 2)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  purchase         Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Inventory {
  id               String         @id @default(uuid())
  storeId          String
  productVariantId String
  stock            Int            @default(0)
  minimumStock     Int            @default(0)
  maximumStock     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  store            Store          @relation(fields: [storeId], references: [id])

  @@unique([storeId, productVariantId])
}

model Transfer {
  id          String         @id @default(uuid())
  fromStoreId String
  toStoreId   String
  status      TransferStatus @default(PENDIENTE)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  fromStore   Store          @relation("SourceStore", fields: [fromStoreId], references: [id])
  toStore     Store          @relation("DestinationStore", fields: [toStoreId], references: [id])
  items       TransferItem[]
}

model TransferItem {
  id               String         @id @default(uuid())
  transferId       String
  productVariantId String
  quantitySent     Int
  quantityReceived Int?
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  transfer         Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String        @id @default(uuid())
  sessionId     String
  localId       String?
  subtotal      Decimal       @default(0) @db.Decimal(10, 2) // <-- Subtotal antes de descuento
  discount      Decimal       @default(0) @db.Decimal(10, 2) // <-- Descuento global
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  
  // Desglose de pagos (súper útil para pagos mixtos)
  paidCash      Decimal       @default(0) @db.Decimal(10, 2)
  paidCard      Decimal       @default(0) @db.Decimal(10, 2)
  paidTransfer  Decimal       @default(0) @db.Decimal(10, 2)
  changeGiven   Decimal       @default(0) @db.Decimal(10, 2)

  reference     String?
  isSynced      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  session       Session       @relation(fields: [sessionId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id               String         @id @default(uuid())
  saleId           String
  productVariantId String
  quantity         Int
  price            Decimal        @db.Decimal(10, 2)
  discount         Decimal        @default(0) @db.Decimal(10, 2) // <-- Descuento individual por variante
  subtotal         Decimal        @default(0) @db.Decimal(10, 2) // <-- (Precio * Cantidad) - Descuento
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  sale             Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id               String      @id @default(uuid())
  firstName        String
  lastName         String
  email            String      @unique
  password         String
  avatar String?
  active           Boolean     @default(true)
  lastLogin DateTime?
  roleId           String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         Session[]
  transfersCreated Transfer[]
  role             Role        @relation(fields: [roleId], references: [id])
  stores           UserStore[]
}

model UserStore {
  id        String  @id @default(uuid())
  userId    String
  storeId   String
  isDefault Boolean @default(false)
  store     Store   @relation(fields: [storeId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, storeId])
}

model Printer {
  id         String      @id @default(uuid())
  registerId String
  name       String
  type       PrinterType
  connection String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  register   Register    @relation(fields: [registerId], references: [id])
}

model Sequence {
  id String @id

  nextProductSku     Int @default(1)
  nextBarcode        Int @default(1)

  nextSaleNumber     Int @default(1)
  nextPurchaseNumber Int @default(1)
  nextTransferNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportHistory {

  id String @id @default(uuid())

  fileName String

  filePath String?

  fileSize Int?

  mimeType String?

  totalRows Int

  importedRows Int

  newProducts Int

  newVariants Int

  updatedRows Int

  errorRows Int

  durationMs Int

  status String @default("COMPLETADA")

  createdAt DateTime @default(now())

  details ImportHistoryDetail[]

}

model ImportHistoryDetail {

  id String @id @default(uuid())

  importId String

  rowNumber Int

  product String?

  brand String?

  category String?

  color String?

  size String?

  status String

  message String?

  sku String?

  import ImportHistory @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])

}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  MIXTO
}

enum TransferStatus {
  PENDIENTE
  EN_TRANSITO
  RECIBIDO
  RECHAZADO
}

enum PrinterType {
  TICKET
  LABEL
}
